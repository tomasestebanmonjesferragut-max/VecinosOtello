<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Avisos de emergencia -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.VecinosOtello">
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${MAPS_API_KEY}" />

        <activity
            android:name=".LogoActivity"
            android:exported="true"
            android:theme="@style/Theme.VecinosOtello.Login">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".LoginActivity"
            android:theme="@style/Theme.VecinosOtello.Login"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".RegistroActivity"
            android:theme="@style/Theme.VecinosOtello.Login"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".MapaActivity"
            android:launchMode="singleTop" />
        <activity
            android:name=".ChatActivity"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".VentasActivity"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".AnunciosActivity"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize" />

        <!-- Mantiene la conexión MQTT de las alertas con la app en segundo plano -->
        <service
            android:name=".VigilanciaService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Avisos de emergencia vecinal en tiempo real" />
        </service>

        <!-- Recibe por FCM las notificaciones de anuncios oficiales -->
        <service
            android:name=".MensajeriaService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="anuncios" />
    </application>

    <!-- Para abrir Google Maps y Waze desde "Ir a casa" (Android 11+) -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.DIAL" />
        </intent>
    </queries>
</manifest>
