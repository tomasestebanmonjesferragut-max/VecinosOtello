<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="22dp"
        android:paddingVertical="28dp">

        <FrameLayout
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_escudo"
            android:elevation="8dp">

            <ImageView
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_escudo"
                app:tint="@color/blanco" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:text="@string/app_name"
            android:textColor="@color/blanco"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="6dp"
            android:text="Comunidad conectada · Pje. Otello"
            android:textColor="#CBD5E1"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:background="@drawable/bg_tarjeta"
            android:elevation="6dp"
            android:orientation="vertical"
            android:padding="22dp">

            <TextView
                style="@style/Titulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:accessibilityHeading="true"
                android:text="Iniciar sesión"
                android:textSize="20sp" />

            <TextView
                style="@style/Subtitulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Entra con tu correo y contraseña."
                android:textSize="14sp" />

            <TextView
                style="@style/Etiqueta"
                android:labelFor="@id/correo"
                android:text="Correo" />

            <EditText
                android:id="@+id/correo"
                style="@style/Campo"
                android:autofillHints="emailAddress"
                android:drawableStart="@drawable/ic_correo"
                android:hint="correo@gmail.com"
                android:inputType="textEmailAddress" />

            <TextView
                style="@style/Etiqueta"
                android:labelFor="@id/clave"
                android:text="Contraseña" />

            <!-- Campo de contraseña con ojo para mostrarla u ocultarla -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp">

                <EditText
                    android:id="@+id/clave"
                    style="@style/Campo"
                    android:layout_marginTop="0dp"
                    android:paddingEnd="52dp"
                    android:autofillHints="password"
                    android:drawableStart="@drawable/ic_cerrado"
                    android:hint="••••••••"
                    android:inputType="textPassword"
                    android:maxLength="64" />

                <ImageButton
                    android:id="@+id/ver_clave"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginEnd="4dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Mostrar contraseña"
                    android:src="@drawable/ic_ojo"
                    app:tint="@color/texto_3" />
            </FrameLayout>

            <TextView
                android:id="@+id/olvide"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_gravity="end"
                android:background="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:paddingHorizontal="4dp"
                android:text="¿Olvidaste tu contraseña?"
                android:textColor="@color/primario"
                android:textSize="13sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/entrar"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="4dp"
                android:text="Entrar"
                android:textSize="16sp"
                android:textStyle="bold"
                app:cornerRadius="14dp" />

            <TextView
                android:id="@+id/error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:accessibilityLiveRegion="polite"
                android:minHeight="18dp"
                android:textColor="@color/peligro"
                android:textSize="13sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/registrarme"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="4dp"
                android:text="Crear una cuenta"
                android:textStyle="bold"
                app:cornerRadius="14dp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
