<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="22dp"
        android:paddingVertical="28dp">

        <FrameLayout
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="32dp"
            android:background="@drawable/bg_escudo"
            android:elevation="8dp">

            <ImageView
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_escudo"
                app:tint="@color/blanco" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:text="@string/app_name"
            android:textColor="@color/blanco"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="6dp"
            android:text="Prevención de riesgo · San Joaquín"
            android:textColor="#CBD5E1"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:background="@drawable/bg_tarjeta"
            android:elevation="6dp"
            android:orientation="vertical"
            android:padding="22dp">

            <TextView
                style="@style/Titulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Iniciar sesión"
                android:textSize="20sp" />

            <TextView
                style="@style/Subtitulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Entra con el correo de tu casa."
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:labelFor="@id/correo"
                android:text="Correo"
                android:textColor="@color/texto"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/correo"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="6dp"
                android:autofillHints="emailAddress"
                android:background="@drawable/bg_campo"
                android:drawableStart="@drawable/ic_correo"
                android:drawablePadding="10dp"
                android:drawableTint="@color/texto_3"
                android:hint="correo@gmail.com"
                android:inputType="textEmailAddress"
                android:paddingHorizontal="14dp"
                android:textColor="@color/texto"
                android:textColorHint="@color/texto_3"
                android:textSize="16sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:labelFor="@id/clave"
                android:text="Contraseña (letras y números, mínimo 8)"
                android:textColor="@color/texto"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/clave"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="6dp"
                android:autofillHints="password"
                android:background="@drawable/bg_campo"
                android:drawableStart="@drawable/ic_cerrado"
                android:drawablePadding="10dp"
                android:drawableTint="@color/texto_3"
                android:hint="••••••••"
                android:inputType="textPassword"
                android:maxLength="32"
                android:paddingHorizontal="14dp"
                android:textColor="@color/texto"
                android:textColorHint="@color/texto_3"
                android:textSize="16sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/entrar"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="20dp"
                android:text="Entrar"
                android:textSize="16sp"
                android:textStyle="bold"
                app:cornerRadius="14dp" />

            <TextView
                android:id="@+id/error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:accessibilityLiveRegion="polite"
                android:minHeight="18dp"
                android:textColor="@color/peligro"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
