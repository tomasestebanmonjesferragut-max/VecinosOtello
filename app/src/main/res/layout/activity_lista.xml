<?xml version="1.0" encoding="utf-8"?>
<!-- Pantalla base de Ventas y Anuncios: encabezado, filtros, lista y botón de publicar -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/blanco"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/blanco"
        android:elevation="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp">

        <ImageButton
            android:id="@+id/volver"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_boton_icono"
            android:contentDescription="Volver al mapa"
            android:src="@drawable/ic_atras"
            app:tint="@color/texto" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/titulo"
                style="@style/Titulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:accessibilityHeading="true"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/subtitulo"
                style="@style/Subtitulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <HorizontalScrollView
        android:id="@+id/filtrosScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/blanco"
        android:scrollbars="none"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/filtros"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingVertical="10dp" />
    </HorizontalScrollView>

    <TextView
        android:id="@+id/error"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:accessibilityLiveRegion="polite"
        android:background="@color/peligro_suave"
        android:paddingHorizontal="14dp"
        android:paddingVertical="8dp"
        android:textColor="@color/peligro"
        android:textSize="13sp"
        android:visibility="gone" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/fondo">

        <ScrollView
            android:id="@+id/scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:id="@+id/contenido"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="14dp"
                android:paddingTop="14dp"
                android:paddingBottom="96dp" />
        </ScrollView>

        <ProgressBar
            android:id="@+id/cargando"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/publicar"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:layout_gravity="bottom|end"
            android:layout_margin="16dp"
            android:elevation="8dp"
            android:paddingHorizontal="20dp"
            android:textStyle="bold"
            android:visibility="gone"
            app:cornerRadius="18dp"
            app:icon="@drawable/ic_mas"
            app:iconTint="@color/blanco" />
    </FrameLayout>
</LinearLayout>
